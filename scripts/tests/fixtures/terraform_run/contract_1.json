{
  "root": "environments/${{ inputs.environment }}",
  "manifest_path": "manifest/manifest.json",
  "state_rules_path": "manifest/state_rules.json",
  "names": [
    "--policy policy",
    "-var \"release=",
    ".terraform.lock.hcl",
    "output -raw release"
  ],
  "calls": [
    {
      "if": "",
      "strict": true,
      "lines": [
        "python3 scripts/tf_inputs.py --environment \"$TARGET\" --manifest \"$MANIFEST_PATH\" --release \"v$RELEASE\" --secrets-file \"$RUNNER_TEMP/tf-secrets.json\" --var-file \"$RUNNER_TEMP/tf-inputs.tfvars.json\" --hashes \"$RUNNER_TEMP/tf-secret-hashes.json\""
      ]
    },
    {
      "if": "inputs.mode != 'recovery'",
      "strict": true,
      "lines": [
        "if [ -z \"$(terraform -chdir=\"$TF_DIR\" state list)\" ]; then",
        "if [ \"$MODE\" != repair ]; then",
        "exit 1",
        "fi",
        "fi",
        "if ! { python3 scripts/tf_state_rules.py --existing-only --base \"$STATE_RULES\" --stored \"$RUNNER_TEMP/before.json\" --existing-out \"$RUNNER_TEMP/state-rules-stored.json\" && python3 scripts/tf_state_extra.py --state \"$RUNNER_TEMP/before.json\" --schema \"$RUNNER_TEMP/schema.json\" --rules \"$RUNNER_TEMP/state-rules-stored.json\" && python3 scripts/tf_state_proof.py --state \"$RUNNER_TEMP/before.json\" --schema \"$RUNNER_TEMP/schema.json\" --rules \"$RUNNER_TEMP/state-rules-stored.json\"; }; then",
        "if [ \"$MODE\" != repair ]; then",
        "exit 1",
        "fi",
        "fi"
      ]
    },
    {
      "if": "inputs.mode == 'apply' || inputs.mode == 'gate-plan' || inputs.mode == 'acceptance' || inputs.mode == 'deploy'",
      "strict": true,
      "lines": [
        "python3 scripts/tf_state_rules.py --environment \"$TARGET\" --manifest \"$MANIFEST_PATH\" --base \"$STATE_RULES\" --plan \"$RUNNER_TEMP/tfplan.proof.json\" --stored \"$RUNNER_TEMP/before.json\" --full-out \"$RUNNER_TEMP/state-rules-full.json\" --existing-out \"$RUNNER_TEMP/state-rules-existing.json\""
      ]
    },
    {
      "if": "inputs.mode == 'gate-plan' || inputs.mode == 'acceptance' || inputs.mode == 'apply'",
      "strict": false,
      "lines": [
        "python3 scripts/tf_plan_proof.py --plan \"$RUNNER_TEMP/tfplan.proof.json\" --planfile \"$RUNNER_TEMP/tfplan\" --stored \"$RUNNER_TEMP/before.json\" --schema \"$RUNNER_TEMP/schema.json\" --rules \"$STATE_RULES\" --existing-rules \"$RUNNER_TEMP/state-rules-existing.json\" --full-rules \"$RUNNER_TEMP/state-rules-full.json\" --var-file \"$RUNNER_TEMP/tf-inputs.tfvars.json\""
      ]
    },
    {
      "if": "inputs.mode == 'repair' && inputs.repair_action == 'import'",
      "strict": true,
      "lines": [
        "python3 scripts/tf_repair_import.py --environment \"$TARGET\" --manifest \"$MANIFEST_PATH\" --address \"$REPAIR_ADDRESS\" --object-id \"$REPAIR_OBJECT_ID\" --var-file \"$RUNNER_TEMP/tf-inputs.tfvars.json\""
      ]
    },
    {
      "if": "always() && (steps.apply.outcome != 'skipped' || steps.push.outcome != 'skipped' || steps.import.outcome != 'skipped')",
      "strict": true,
      "lines": [
        "if ! terraform -chdir=\"$TF_DIR\" state pull > \"$RUNNER_TEMP/after.json\"; then",
        "exit 1",
        "fi",
        "if [ -z \"$(terraform -chdir=\"$TF_DIR\" state list)\" ]; then",
        "exit 1",
        "fi",
        "if [ \"$MODE\" = repair ]; then",
        "python3 scripts/tf_state_rules.py --existing-only --base \"$STATE_RULES\" --stored \"$after\" --existing-out \"$written\"",
        "python3 scripts/tf_state_extra.py --state \"$after\" --schema \"$schema\" --rules \"$written\"",
        "python3 scripts/tf_state_proof.py --state \"$after\" --schema \"$schema\" --rules \"$written\"",
        "elif [ \"$APPLY\" = success ]; then",
        "python3 scripts/tf_state_extra.py --state \"$after\" --schema \"$schema\" --rules \"$full\"",
        "python3 scripts/tf_state_proof.py --state \"$after\" --schema \"$schema\" --rules \"$full\"",
        "else",
        "python3 scripts/tf_state_rules.py --existing-only --base \"$STATE_RULES\" --stored \"$after\" --existing-out \"$written\"",
        "python3 scripts/tf_state_extra.py --state \"$after\" --schema \"$schema\" --rules \"$written\" --partial-plan \"$RUNNER_TEMP/tfplan.proof.json\"",
        "python3 scripts/tf_state_proof.py --state \"$after\" --schema \"$schema\" --rules \"$written\"",
        "fi"
      ]
    }
  ]
}
